# Dependencies and build output
node_modules/
dist/
coverage/
*.tsbuildinfo

# Logs
*.log
npm-debug.log*

# Local environment and secrets (never commit real credentials)
.env
.env.*
!.env.example
!infra/local/.env.example
provider.env
secrets/
.local/

# Database dumps / backup artifacts (migration .sql sources stay trackable)
*.dump
*.pgdump
*.backup
*.sql.gz

# Private key material
*.key
*.pem
# Private operator reports over real data (never committed, never published)
.private/

# Generated public snapshots (reproducible with npm run snapshot:demo)
apps/web/public/public-data/
public-data/

# Editors / OS
.DS_Store
Thumbs.db
.vscode/
.idea/

# Agent tooling is per developer, never vendored
.claude/
skills-lock.json
